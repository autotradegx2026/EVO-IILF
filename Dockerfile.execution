FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY lib ./lib
COPY types ./types
COPY scripts/execution-worker.ts ./scripts/execution-worker.ts
RUN npm run execution:build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.execution-build ./.execution-build
USER node
CMD ["node", ".execution-build/scripts/execution-worker.js"]
