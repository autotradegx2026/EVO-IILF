# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-key

# Resend
RESEND_API_KEY=re_your_key

# Webhook security (generate: openssl rand -hex 32)
WEBHOOK_SECRET=your-webhook-secret

# Angel One
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo UI; keep both false for authenticated operation
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Remain false until broker reconciliation and deployment acceptance are verified
LIVE_TRADING_ENABLED=false
BROKER_TESTNET_ENABLED=false
# Optional authenticated one-pass worker endpoint; continuous worker is preferred.
EXECUTION_WORKER_SECRET=
# Angel cash INTRADAY: operator-maintained exchange trading-date allowlist, YYYY-MM-DD comma-separated.
ANGEL_TRADING_DATES=
# Must be at or before 15:00 IST, ahead of the broker's own square-off window.
ANGEL_SQUARE_OFF_TIME=15:00

# Optional email worker. Configure an external POST schedule only after verifying the sender.
ALERT_EMAILS_ENABLED=false
RESEND_FROM_EMAIL=
CRON_SECRET=
