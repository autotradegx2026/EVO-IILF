{
  "name": "evo-iilf-platform",
  "version": "1.0.0",
  "description": "EVO-IILF Algo Automation Platform by GrindX Technologies",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "execution:build": "tsc --strict --target ES2022 --module commonjs --esModuleInterop --skipLibCheck --outDir .execution-build scripts/execution-worker.ts",
    "execution:worker": "node .execution-build/scripts/execution-worker.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/database.ts",
    "supabase:migrate": "supabase db push",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "strategy:export": "tsc --target ES2017 --module commonjs --esModuleInterop --skipLibCheck --outDir .test-build/export scripts/export-pine.ts && node .test-build/export/scripts/export-pine.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.44.4",
    "@tanstack/react-query": "^5.51.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.414.0",
    "next": "14.2.35",
    "otpauth": "^9.3.4",
    "radix-ui": "^1.6.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.1",
    "react-ts-tradingview-widgets": "^1.2.8",
    "recharts": "^2.12.7",
    "resend": "^3.4.0",
    "shadcn": "^4.11.0",
    "smartapi-javascript": "^1.0.5",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
